# Copy to apps/api/.env (or export). NEVER commit real keys. All variables are optional except where noted.

# ---- Runtime ----------------------------------------------------------------
# DEV | TEST | LOCAL | PRODUCTION | DEMO
NODO_ENV=DEV
# FREE | BALANCED | PERFORMANCE | PRIVATE | CUSTOM
NODO_MODE=FREE
# production: postgresql+psycopg://user:pass@host/nodo
NODO_DATABASE_URL=sqlite:///./nodo.db
# if set, every API call needs "Authorization: Bearer <token>"
NODO_API_TOKEN=
NODO_DEFAULT_LANGUAGE=it
# true = load Studio Nodo demo fixtures at startup (idempotent)
NODO_SEED_DEMO_DATA=false

# ---- Model providers (absence = provider not registered) --------------------
# Local (free, private; highest privacy class allowed)
# e.g. http://127.0.0.1:11434
NODO_OLLAMA_BASE_URL=
NODO_OLLAMA_MODEL=llama3.2
# Free-tier cloud (INTERNAL data max)
NODO_GROQ_API_KEY=
NODO_GROQ_MODEL=llama-3.3-70b-versatile
NODO_OPENROUTER_API_KEY=
# ":free" suffix marks it free-tier
NODO_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Paid (never used in FREE mode unless NODO_ALLOW_PAID_IN_FREE_MODE=true)
NODO_OPENAI_API_KEY=
NODO_OPENAI_MODEL=gpt-4o-mini
NODO_OPENAI_BASE_URL=https://api.openai.com/v1
NODO_ALLOW_PAID_IN_FREE_MODE=false
# Anthropic (Claude) a consumo, con chiave API (alternativa all'abbonamento qui sotto)
NODO_ANTHROPIC_API_KEY=
NODO_ANTHROPIC_MODEL=claude-sonnet-4-5
# Google Gemini: gratis entro i limiti di AI Studio (aistudio.google.com/apikey)
NODO_GEMINI_API_KEY=
NODO_GEMINI_MODEL=gemini-2.5-flash

# ---- Cervello (docs/CERVELLO.md) ----------------------------------------------------
# Il tuo abbonamento Claude Pro/Max tramite Claude Code installato su questo PC (comando "claude"):
# niente chiavi e niente costi in piu'. Si attiva da solo se Claude Code e' installato e hai fatto l'accesso.
NODO_CLAUDE_SUBSCRIPTION=true
# sonnet (consigliato) | opus | haiku
NODO_CLAUDE_CLI_MODEL=sonnet
# velocita' delle risposte in conversazione: low (rapido) | medium | high
NODO_CLAUDE_CLI_EFFORT=low
# percorso completo di claude.exe, solo se NODO non lo trova da solo
NODO_CLAUDE_CLI_PATH=
# auto (acceso se c'e' un'AI capace di usare strumenti) | on | off (solo regole fisse)
NODO_BRAIN=auto
NODO_BRAIN_MAX_STEPS=6
NODO_BRAIN_HISTORY=16

# ---- Voice -------------------------------------------------------------------
# browser (Web Speech API, free, on-device) | openai | fake
NODO_STT_PROVIDER=browser
# browser | openai | fake
NODO_TTS_PROVIDER=browser
NODO_TTS_VOICE=alloy

# ---- Tools -------------------------------------------------------------------
# fine-grained PAT: Contents RW, Pull requests RW, Metadata R, Dependabot alerts R, Actions R (docs/ACCESSI.md)
NODO_GITHUB_TOKEN=
# auto (http, fake in TEST/DEMO) | http | fake
NODO_GITHUB_CONNECTOR=auto

# ---- Agent budgets -----------------------------------------------------------
NODO_AGENT_MAX_MODEL_CALLS=4
NODO_AGENT_MAX_TOOL_CALLS=8
NODO_AGENT_MAX_SECONDS=60
NODO_AGENT_MAX_DEPTH=2

# ---- Vercel (turno di notte) ----------------------------------------------------
# Vercel -> Account Settings -> Tokens (docs/ACCESSI.md)
NODO_VERCEL_TOKEN=
# team_xxx se i progetti stanno in un team; vuoto = account personale
NODO_VERCEL_TEAM_ID=
# auto | http | fake
NODO_VERCEL_CONNECTOR=auto
# "Protection Bypass for Automation": serve solo se le anteprime sono protette
NODO_VERCEL_PROTECTION_BYPASS=

# ---- Turno di notte (docs/NIGHT_SHIFT.md) ---------------------------------------
# il pianificatore gira dentro NODO finche' e' acceso
NODO_NIGHT_ENABLED=true
NODO_TIMEZONE=Europe/Rome
# giro completo: tutti i controlli + correzioni + bozze
NODO_NIGHT_START=01:00
NODO_NIGHT_END=07:00
# giri rapidi durante la notte
NODO_NIGHT_INTERVAL_MINUTES=60
# giri rapidi di giorno (0 = spenti)
NODO_DAY_INTERVAL_MINUTES=0
# briefing del mattino (inviato su Telegram se configurato)
NODO_BRIEFING_TIME=07:30
# sito giu' dopo un deploy -> torna alla versione sana (reversibile)
NODO_NIGHT_AUTO_ROLLBACK=true
# build fallita per errore di rete -> la rilancia una volta
NODO_NIGHT_AUTO_REDEPLOY=true
# prepara correzioni su branch + PR (la pubblicazione chiede SEMPRE il tuo ok)
NODO_NIGHT_FIX_PRS=true
# le correzioni possono usare un modello a pagamento anche in modalita' FREE...
NODO_NIGHT_FIX_ALLOW_PAID=true
# ...entro questo tetto di spesa per notte
NODO_NIGHT_MAX_COST_USD=1.0
NODO_NIGHT_MAX_FIXES=3
# bozze dei contenuti pianificati (serve un modello linguistico)
NODO_NIGHT_DRAFTS=true
NODO_NIGHT_MAX_DRAFTS=3
# attesa massima dell'anteprima Vercel di una correzione
NODO_NIGHT_PREVIEW_WAIT_SECONDS=360
# usa Chromium (Playwright) per vedere gli errori JavaScript
NODO_NIGHT_BROWSER_CHECKS=true
NODO_NIGHT_SLOW_MS=3000
# importa da solo i nuovi progetti Vercel
NODO_NIGHT_AUTO_DISCOVER=true
# Windows: impedisce la sospensione durante il turno
NODO_KEEP_AWAKE=true

# ---- Notifiche ------------------------------------------------------------------
# @BotFather -> /newbot
NODO_TELEGRAM_BOT_TOKEN=
# il tuo chat id (docs/ACCESSI.md)
NODO_TELEGRAM_CHAT_ID=
# avviso immediato se un sito va giu' di notte
NODO_NOTIFY_CRITICAL=true
# Telegram a due vie: rispondi, chiedi e approva dal telefono (solo dal tuo chat id)
NODO_TELEGRAM_COMMANDS=true
