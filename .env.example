# Copy to apps/api/.env (or export). NEVER commit real keys. All variables are optional except where noted.

# ---- Runtime ----------------------------------------------------------------
NODO_ENV=DEV                         # DEV | TEST | LOCAL | PRODUCTION | DEMO
NODO_MODE=FREE                       # FREE | BALANCED | PERFORMANCE | PRIVATE | CUSTOM
NODO_DATABASE_URL=sqlite:///./nodo.db   # production: postgresql+psycopg://user:pass@host/nodo
NODO_API_TOKEN=                      # if set, every API call needs "Authorization: Bearer <token>"
NODO_DEFAULT_LANGUAGE=it
NODO_SEED_DEMO_DATA=false            # true = load Studio Nodo demo fixtures at startup (idempotent)

# ---- Model providers (absence = provider not registered) --------------------
# Local (free, private; highest privacy class allowed)
NODO_OLLAMA_BASE_URL=                # e.g. http://127.0.0.1:11434
NODO_OLLAMA_MODEL=llama3.2
# Free-tier cloud (INTERNAL data max)
NODO_GROQ_API_KEY=
NODO_GROQ_MODEL=llama-3.3-70b-versatile
NODO_OPENROUTER_API_KEY=
NODO_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   # ":free" suffix marks it free-tier
# Paid (never used in FREE mode unless NODO_ALLOW_PAID_IN_FREE_MODE=true)
NODO_OPENAI_API_KEY=
NODO_OPENAI_MODEL=gpt-4o-mini
NODO_OPENAI_BASE_URL=https://api.openai.com/v1
NODO_ALLOW_PAID_IN_FREE_MODE=false

# ---- Voice -------------------------------------------------------------------
NODO_STT_PROVIDER=browser            # browser (Web Speech API, free, on-device) | openai | fake
NODO_TTS_PROVIDER=browser            # browser | openai | fake
NODO_TTS_VOICE=alloy

# ---- Tools -------------------------------------------------------------------
NODO_GITHUB_TOKEN=                   # fine-grained PAT, read-only scopes are enough for V0.1
NODO_GITHUB_CONNECTOR=auto           # auto (http, fake in TEST/DEMO) | http | fake

# ---- Agent budgets -----------------------------------------------------------
NODO_AGENT_MAX_MODEL_CALLS=4
NODO_AGENT_MAX_TOOL_CALLS=8
NODO_AGENT_MAX_SECONDS=60
NODO_AGENT_MAX_DEPTH=2
